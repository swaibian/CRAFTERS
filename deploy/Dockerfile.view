# Crafter view image: static build served over :80, /api proxied to controller.
#
# Build stage needs npm (registry reachable at build time); the runtime
# stage is static-only (nginx) with no secrets anywhere.

FROM node:22-slim AS build
WORKDIR /build
COPY view/package.json view/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY view/ ./
RUN npm run build

FROM nginx:alpine AS runtime
COPY deploy/nginx.view.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist/ /usr/share/nginx/html/
EXPOSE 80
